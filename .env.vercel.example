# ============================================================================
# .env.vercel.example — Variables d'environnement pour Vercel
# ----------------------------------------------------------------------------
# Copiez ce fichier vers .env pour tester en local avec PostgreSQL,
# ET ajoutez ces mêmes variables dans le dashboard Vercel :
#   Settings → Environment Variables
# ============================================================================

# --- BASE DE DONNÉES POSTGRESQL (obligatoire sur Vercel) -------------------
# SQLite ne fonctionne pas sur Vercel (filesystem éphémère).
# Utilisez Neon (https://neon.tech) — gratuit, serverless, 0.1 GB suffisant.
#
# 1. Créez un compte sur https://neon.tech (ou connectez-vous avec GitHub)
# 2. New Project → nommez-le "masomo"
# 3. Copiez la "Connection string" affichée (format ci-dessous)
# 4. Remplacez les placeholders par vos vraies valeurs
#
# Format : postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://masomo:VOTRE_MOT_DE_PASSE@ep-xxx.region.aws.neon.tech/masomo?sslmode=require"

# --- URL PUBLIQUE DE L'APP -------------------------------------------------
# Une fois déployée sur Vercel, cette URL sera :
#   https://masomo.vercel.app  (ou votre domaine personnalisé)
# En local : http://localhost:3000
NEXTAUTH_URL="https://VOTRE_PROJET.vercel.app"

# --- SECRET NEXTAUTH (générez une chaîne aléatoire) ------------------------
# Générez avec : openssl rand -base64 32
# Ou : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="generer-une-chaine-aleatoire-de-64-caracteres-ici"

# --- PORT (local seulement, ignoré sur Vercel) -----------------------------
PORT=3000
